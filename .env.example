# The site runs on Cloudways as plain files plus a few PHP scripts.
# These values go in GitHub → Settings → Secrets and variables → Actions (not in a file).
# The deploy workflow writes the ones the PHP scripts need into api/_config.php on the server.

# --- Secrets ---
CLOUDWAYS_HOST=          # server public IP (Cloudways → Servers → your server → Master Credentials)
CLOUDWAYS_USER=          # master username
CLOUDWAYS_PASSWORD=      # master password (or use CLOUDWAYS_SSH_KEY instead)
CLOUDWAYS_APP=           # the app's folder name, e.g. abcdefghij (same as its database name)
CLOUDWAYS_SSH_KEY=       # optional: private SSH key instead of the password
ADMIN_PASSWORD=          # password for nearshoreadventures.com/admin
SITE_GITHUB_TOKEN=       # fine-grained token, this repo only, "Contents: read and write"
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
ANTHROPIC_API_KEY=       # optional: lets the round-up read pages that have no calendar feed

# --- Variables ---
SITE_URL=https://nearshoreadventures.com
