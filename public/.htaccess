# Cloudways (Apache) settings for the static site
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # On the real domain, always use https and drop "www".
  # (The temporary Cloudways review address is left alone.)
  RewriteCond %{HTTP_HOST} ^(www\.)?nearshoreadventures\.com$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://nearshoreadventures.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Keep the temporary review address out of Google
SetEnvIfNoCase Host "cloudwaysapps\.com$" REVIEW_SITE

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=REVIEW_SITE
  # Built assets have content hashes in their names, so they can be cached for a long time
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages change after every round-up, so browsers should check back
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
