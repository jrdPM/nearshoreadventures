# Copy to .env.local for local development. On Vercel, add these under Project Settings → Environment Variables.

# The live site address (used in emails, calendar links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://nearshoreadventures.com

# Password for /admin, where you approve or remove events in the review queue
ADMIN_PASSWORD=

# A GitHub fine-grained token with "Contents: read and write" on this repo.
# Lets the admin page and the "Add your event" form save to data/*.json.
GITHUB_TOKEN=
GITHUB_REPO=jrdPM/nearshoreadventures
GITHUB_BRANCH=main

# Beehiiv (Settings → API). Used for signups on the site and the Thursday send.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Optional: lets the round-up read event pages that have no feed (GitHub Actions secret, not Vercel).
ANTHROPIC_API_KEY=
